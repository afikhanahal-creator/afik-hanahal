# URL of your Render server (no trailing slash).
# Set this in Vercel → Project Settings → Environment Variables.
# Leave empty to use localStorage-only mode (useful for local dev without the server).
VITE_API_URL=https://afik-hanahal-server.onrender.com

# Image CDN used to proxy/optimise property photos served from Supabase Storage.
# It fetches each image from Supabase ONCE, caches it at the edge, and serves a
# resized + compressed WebP copy to every visitor — this is what keeps Supabase
# egress inside the free tier (otherwise every browser pulls full-size originals
# straight from Supabase on every page view).
# Default: https://wsrv.nl (free, no account). Set to empty to disable proxying.
VITE_IMG_CDN=https://wsrv.nl

# ── Property intake (/newproperty → Supabase → admin "נכסים שנקלטו" → publish to the site) ──
# Server-side only (Vercel → Environment Variables). Required:
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional — office notifications on every new property (WhatsApp via Green API + email via Gmail):
WA_GREENAPI_INSTANCE=
WA_GREENAPI_TOKEN=
BUSINESS_NOTIFY_CHATID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFY_EMAIL=
# Optional — property generator backend (defaults to the Render server) and admin token override:
RENDER_URL=
ADMIN_TOKEN=
# Optional — second homes for every submitted questionnaire, independent of Supabase:
#   Vercel Blob (Vercel → Storage → Create → Blob; the token is injected automatically) — failover store when Supabase refuses writes
BLOB_READ_WRITE_TOKEN=
#   Private GitHub archive (owner-controlled repo, one JSON + one readable .md per form, written on EVERY submission)
#   Fine-grained PAT with "Contents: Read and write" on that repo only.
GITHUB_ARCHIVE_TOKEN=
GITHUB_ARCHIVE_REPO=afikhanahal-creator/afik-hanahal-records

# WhatsApp automations — optional secret for the external "precise timing" ping
# (e.g. cron-job.org every 5 minutes → https://www.afikhanahal.co.il/api/meta/auto-tick?key=<AUTOMATION_KEY>)
AUTOMATION_KEY=

# Google Analytics 4 — direct Data API for the admin "Google Analytics" tab (free, replaces Supermetrics).
# Google Cloud → IAM → Service accounts → create → Keys → JSON. Enable "Google Analytics Data API".
# GA4 → Admin → Property access management → add the service-account email as Viewer.
# Paste the whole JSON key (or its base64). Never commit it.
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=536943897

# Smart lead analysis (admin → lead card → "נתח ליד"): Claude briefing on top of the rule-based score.
# Without it the analysis still shows the rule score, and the briefing runs through the Render AI proxy.
ANTHROPIC_API_KEY=

# ── Instant property pages (/p/<id>) ─────────────────────────────────────────
# Optional: a Vercel Deploy Hook (Project → Settings → Git → Deploy Hooks). When set, saving / publishing a
# property rebuilds the site (at most once a minute), so every property gets its instant static page.
VERCEL_DEPLOY_HOOK_URL=
# Optional: the public origin used in the static pages' links and Open Graph tags
SITE_ORIGIN=https://www.afikhanahal.co.il
